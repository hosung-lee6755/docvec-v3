# Windows 기본 TLS 스택(schannel — curl.exe, 구형 .NET)은 IP 리터럴로 접속할 때
# SNI를 아예 보내지 않는다("using IP address, SNI is not supported by OS"). Caddy는
# SNI가 없으면 어떤 사이트 설정을 써야 할지 몰라 핸드셰이크를 internal error로
# 거부하므로(2026-08-03 실측 — openssl -servername은 성공, SNI 없이는 서버가
# TLS alert로 거부), SNI 없는 연결을 이 IP로 취급하도록 기본값을 명시한다.
{
	default_sni 192.168.0.90
}

# 도메인 없이 IP로만 접속하는 구성이라 Let's Encrypt 자동 발급 대신 Caddy 내장
# 로컬 CA로 자체 서명 인증서를 발급한다("tls internal"). 외부 방문자의 브라우저에는
# 이 CA가 등록돼 있지 않으므로 "안전하지 않음" 경고가 뜨는 게 정상이다 — 접속은
# 여전히 암호화되며, 경고는 "이 서버가 진짜 그 IP가 맞는지 제3자가 보증하지 않는다"는
# 뜻일 뿐이다. 나중에 도메인이 생기면 이 주소만 도메인으로 바꿔 Let's Encrypt로
# 전환하면 된다.
#
# 사이트 주소를 실제 LAN IP로 명시해야 한다 — 바로 ":443"처럼 포트만 쓰면 Caddy가
# 이 연결에 내줄 인증서를 SNI에 의존해 고르는데, IP 리터럴로 접속하는 클라이언트는
# TLS 확장에서 SNI를 아예 안 보내는 경우가 많아(RFC 6066) 핸드셰이크가 실패한다
# (2026-08-03 실측 — curl schannel과 Chrome 둘 다 SSL_PROTOCOL_ERROR). 주소를
# 명시하면 Caddy가 그 IP를 SAN으로 넣어 발급하고 SNI 유무와 무관하게 기본
# 인증서로 서빙하며, http(80)->https(443) 리다이렉트도 자동으로 설정된다.
192.168.0.3, 192.168.0.90, 49.168.97.107 {
	# 최근 Caddy/Go는 TLS1.3 키교환 그룹으로 포스트퀀텀 하이브리드
	# (X25519MLKEM768)을 최우선으로 협상하는데, Windows 기본 TLS 스택
	# (schannel — curl.exe, .NET SslStream)이 이를 아직 지원하지 않아
	# 핸드셰이크 자체가 깨진다(2026-08-03 실측 — openssl s_client는 성공,
	# curl/PowerShell/Chrome은 SEC_E_INTERNAL_ERROR·ERR_SSL_PROTOCOL_ERROR).
	# 널리 지원되는 고전 커브로 제한해 호환성을 우선한다.
	tls internal {
		curves x25519 secp256r1 secp384r1
	}

	encode gzip

	# Security headers
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	header X-Frame-Options DENY
	header Permissions-Policy "camera=(), microphone=(), geolocation=()"
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

	# 원본 문서/아티팩트 다운로드(presigned URL)를 같은 출처(443)로 중계한다. 브라우저가 MinIO
	# 포트(9002)에 직접 붙지 않아도 되므로 외부에는 443/80만 열면 된다. 서명은 Host 헤더를
	# 포함해 검증되므로 Host를 바꾸지 말 것(reverse_proxy 기본값이 원본 Host 유지).
	# 버킷은 비공개라 서명 없는 요청은 MinIO가 거부한다. 읽기 전용 메서드만 허용한다.
	@minio {
		path /originals/* /artifacts/*
		method GET HEAD
	}
	handle @minio {
		# 변환 미리보기(HTML)는 iframe 으로 띄우므로 같은 출처 프레임만 허용한다(전역 DENY 덮어쓰기).
		header X-Frame-Options SAMEORIGIN
		# 서명 URL 의 출처가 앱 출처와 달라도(예: 접속 주소와 MINIO_PUBLIC_ENDPOINT 가 다른 경우)
		# 앱이 fetch 로 받을 수 있게 읽기 전용 경로에만 CORS 를 연다. 서명이 없으면 어차피 403 이다.
		header Access-Control-Allow-Origin "*"
		# 이제 MinIO 가 앱과 같은 출처라, 문서에서 변환된 HTML 이 앱 권한으로 스크립트를 실행하지 못하게
		# CSP sandbox(고유 출처)를 건다. PDF 는 브라우저 PDF 뷰어가 처리하고, sandbox 가 걸린 PDF 는
		# iframe 에서 뷰어가 차단되므로(원문대조의 대체 경로가 깨짐) PDF 에는 걸지 않는다.
		@notpdf not path_regexp (?i)\.pdf$
		header @notpdf Content-Security-Policy "sandbox; default-src 'none'; img-src data: blob:; style-src 'unsafe-inline'; font-src data:"
		# presigned URL 은 호스트 없는 상대 경로로 내려가므로(MINIO_RELATIVE_URLS) 브라우저가 접속한 출처로 들어온다.
		# 서명은 MINIO_PUBLIC_ENDPOINT 호스트로 계산되어 있으니 MinIO 로 보낼 때 Host 를 그 값으로 되돌린다.
		reverse_proxy minio:9000 {
			header_up Host {$MINIO_PUBLIC_ENDPOINT}
		}
	}

	# frontend 컨테이너의 nginx가 /api/를 api:8000으로 다시 프록시하므로,
	# 여기서는 frontend 하나에만 전달하면 된다(apiClient.ts가 상대경로만 씀).
	handle {
		reverse_proxy frontend:80
	}
}
