# ============================================================
# DocVec Platform — Environment Configuration
# Copy this file to .env and fill in real values.
# ============================================================

# App
APP_NAME="DocVec Platform"
ENVIRONMENT=development         # development | staging | production
LOG_LEVEL=info
DEBUG=false

# Security (REQUIRED — change before deploying)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# App refuses to start in production (ENVIRONMENT=production) if this is left at the default.
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Dedicated key for encrypting stored BYOK API keys (Fernet, via PBKDF2). REQUIRED:
# docker-compose.yml refuses to start without it, and the app refuses to start with
# ENVIRONMENT=production when it is empty. Only outside production does the code fall back
# to SECRET_KEY. Generate the same way as SECRET_KEY.
# Changing it later makes every already-encrypted value unreadable until it is re-encrypted,
# so keep the value that was used when the data was written.
ENCRYPTION_KEY=

# Comma-separated list of allowed frontend origins, required when ENVIRONMENT=production
# (e.g. https://app.example.com,https://example.com). App refuses to start without it.
CORS_ALLOWED_ORIGINS=

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://docvec:docvec_secret@localhost:5432/docvec

# Redis
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=documents

# MinIO
MINIO_ENDPOINT=localhost:9000
# Host used only for generating presigned download URLs — must be reachable from the
# end user's browser, unlike MINIO_ENDPOINT which the API/worker use internally.
MINIO_PUBLIC_ENDPOINT=localhost:9000
# true 이면 presigned URL 을 https 로 만든다. Caddy(https) 뒤에서 MinIO 를 같은 출처로 중계할 때
# MINIO_PUBLIC_ENDPOINT=<Caddy 사이트 주소, 포트 없이> 와 함께 설정한다(유지보수_가이드 1.9).
MINIO_PUBLIC_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio_secret
MINIO_SECURE=false
MINIO_BUCKET_ORIGINALS=originals
MINIO_BUCKET_ARTIFACTS=artifacts

# Pipeline defaults
DEFAULT_CHUNK_MAX_TOKENS=512
DEFAULT_CHUNK_MIN_TOKENS=50
DEFAULT_CHUNK_OVERLAP_TOKENS=64
# One of: bge-m3 | multilingual-e5-large | ko-sroberta-multitask | kr-sbert | openai | mock
# See backend/app/services/embedding.py EMBEDDING_MODEL_REGISTRY for the full list.
# Non-openai/mock models must be warmed up first via:
#   docker compose exec worker poetry run python -m app.pipeline.download_models
DEFAULT_EMBEDDING_MODEL=bge-m3
DEFAULT_EMBEDDING_DIMENSION=1024

# OpenAI (optional — only used when DEFAULT_EMBEDDING_MODEL=openai)
OPENAI_API_KEY=

# Celery Flower basic auth — REQUIRED (docker-compose.yml refuses to start without it).
# Plain "username:password", passed as-is to `flower --basic_auth` (NOT base64-encoded;
# several users can be given comma-separated). Use a long random password.
FLOWER_BASIC_AUTH=
