FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    POETRY_VERSION=2.4.1 \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=1 \
    POETRY_VIRTUALENVS_CREATE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libxcb1 \
    curl \
    tesseract-ocr \
    tesseract-ocr-kor \
    libreoffice-writer \
    fonts-nanum \
    && rm -rf /var/lib/apt/lists/*

RUN pip install poetry==${POETRY_VERSION}

WORKDIR /app

COPY pyproject.toml poetry.lock* ./

FROM base AS production
RUN poetry install --without dev --no-root
# 원문 보기용 LibreOffice calc, impress와 한글 확장 H2Orestart(2026-11-23)
COPY scripts/install_original_preview_tools.sh /tmp/
RUN sh /tmp/install_original_preview_tools.sh && rm -f /tmp/install_original_preview_tools.sh
COPY . .
RUN poetry install --without dev

FROM base AS development
RUN poetry install --no-root
# 원문 보기용 LibreOffice calc, impress와 한글 확장 H2Orestart(2026-11-23)
COPY scripts/install_original_preview_tools.sh /tmp/
RUN sh /tmp/install_original_preview_tools.sh && rm -f /tmp/install_original_preview_tools.sh
COPY . .
RUN poetry install

CMD ["poetry", "run", "celery", "-A", "app.pipeline.celery_app", "worker", "--loglevel=info", "--concurrency=4", "-Q", "critical,high,normal,low,embed"]
